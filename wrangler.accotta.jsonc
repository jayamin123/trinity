{
  // Accotta deployment (flows.accotta.me). Identical to wrangler.jsonc except
  // the D1 database_id and the custom-domain route point at Accotta's account,
  // not Apollo's. Deploy with: wrangler deploy -c wrangler.accotta.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity-flows",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1"
  },
  "routes": [
    { "pattern": "flows.accotta.me", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trinity-flows",
      "database_id": "04ada44c-56fc-4f42-aed0-f75c8e073f20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "trinity-uploads"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
